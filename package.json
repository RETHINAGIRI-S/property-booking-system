{
  "name": "property-booking-system",
  "version": "1.0.0",
  "description": "HomelyHub Fullstack Property Booking System",
  "main": "backend/index.js",
  "type": "module",
  "scripts": {
    "start": "node backend/index.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "node --watch backend/index.js",
    "client": "npm run dev --prefix frontend",
    "seed": "node backend/index.js --seed",
    "seed:delete": "node backend/index.js --delete",
    "build": "npm install --prefix frontend && npm run build --prefix frontend"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq-sdk": "^1.6.0",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mailgen": "^2.0.36",
    "mongoose": "^9.10.1",
    "nodemailer": "^10.0.10",
    "slugify": "^1.6.9",
    "validator": "^13.15.35"
  }
}